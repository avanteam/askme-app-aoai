apiVersion: v1
kind: Secret
metadata:
  name: askme-secrets
  namespace: askme-app
type: Opaque
stringData:
  # Azure OpenAI
  AZURE_OPENAI_ENDPOINT: "https://your-resource.openai.azure.com/"
  AZURE_OPENAI_KEY: "YOUR_AZURE_OPENAI_KEY_HERE"
  AZURE_OPENAI_RESOURCE: "your-resource-name"
  AZURE_OPENAI_MODEL: "your-deployment-name"
  AZURE_OPENAI_MODEL_NAME: "gpt-4o"
  AZURE_OPENAI_TEMPERATURE: "0.7"
  AZURE_OPENAI_TOP_P: "0.95"
  AZURE_OPENAI_STOP_SEQUENCE: ""
  AZURE_OPENAI_SEED: ""
  AZURE_OPENAI_CHOICES_COUNT: "1"
  AZURE_OPENAI_PRESENCE_PENALTY: "0.0"
  AZURE_OPENAI_FREQUENCY_PENALTY: "0.0"
  AZURE_OPENAI_LOGIT_BIAS: ""
  AZURE_OPENAI_USER: ""
  AZURE_OPENAI_TOOLS: ""
  AZURE_OPENAI_TOOL_CHOICE: ""
  AZURE_OPENAI_SYSTEM_MESSAGE: "Your system message here"
  AZURE_OPENAI_PREVIEW_API_VERSION: "2024-05-01-preview"
  AZURE_OPENAI_STREAM: "True"
  AZURE_OPENAI_EMBEDDING_NAME: "text-embedding-ada-002"
  AZURE_OPENAI_EMBEDDING_ENDPOINT: ""
  AZURE_OPENAI_EMBEDDING_KEY: ""
  AZURE_OPENAI_RESPONSE_VERY_SHORT_MAX_TOKENS: "1000"
  AZURE_OPENAI_RESPONSE_NORMAL_MAX_TOKENS: "6000"
  AZURE_OPENAI_RESPONSE_COMPREHENSIVE_MAX_TOKENS: "16000"
  
  # Claude
  CLAUDE_API_KEY: "YOUR_CLAUDE_API_KEY_HERE"
  CLAUDE_MODEL: "claude-3-sonnet-20240229"
  CLAUDE_TEMPERATURE: "0"
  CLAUDE_TOP_P: "1.0"
  CLAUDE_SYSTEM_MESSAGE: "Your Claude system message here"
  CLAUDE_RESPONSE_VERY_SHORT_MAX_TOKENS: "2000"
  CLAUDE_RESPONSE_NORMAL_MAX_TOKENS: "10000"
  CLAUDE_RESPONSE_COMPREHENSIVE_MAX_TOKENS: "40000"
  
  # OpenAI Direct
  OPENAI_DIRECT_API_KEY: "YOUR_OPENAI_API_KEY_HERE"
  OPENAI_DIRECT_MODEL: "gpt-4"
  OPENAI_DIRECT_TEMPERATURE: "0.2"
  OPENAI_DIRECT_TOP_P: "1.0"
  OPENAI_DIRECT_STOP_SEQUENCE: ""
  OPENAI_DIRECT_BASE_URL: "https://api.openai.com/v1"
  OPENAI_DIRECT_SYSTEM_MESSAGE: "Your OpenAI system message here"
  OPENAI_DIRECT_RESPONSE_VERY_SHORT_MAX_TOKENS: "1500"
  OPENAI_DIRECT_RESPONSE_NORMAL_MAX_TOKENS: "8000"
  OPENAI_DIRECT_RESPONSE_COMPREHENSIVE_MAX_TOKENS: "16000"
  
  # Mistral
  MISTRAL_API_KEY: "YOUR_MISTRAL_API_KEY_HERE"
  MISTRAL_MODEL: "mistral-large-latest"
  MISTRAL_MAX_TOKENS: "1000"
  MISTRAL_TEMPERATURE: "0.7"
  MISTRAL_TOP_P: "1.0"
  MISTRAL_SYSTEM_MESSAGE: "Your Mistral system message here"
  MISTRAL_RESPONSE_VERY_SHORT_MAX_TOKENS: "1500"
  MISTRAL_RESPONSE_NORMAL_MAX_TOKENS: "8000"
  MISTRAL_RESPONSE_COMPREHENSIVE_MAX_TOKENS: "30000"
  
  # Gemini
  GEMINI_API_KEY: "YOUR_GEMINI_API_KEY_HERE"
  GEMINI_MODEL: "gemini-1.5-flash"
  GEMINI_TEMPERATURE: "0.7"
  GEMINI_TOP_P: "1.0"
  GEMINI_SYSTEM_MESSAGE: "Your Gemini system message here"
  GEMINI_RESPONSE_VERY_SHORT_MAX_TOKENS: "1500"
  GEMINI_RESPONSE_NORMAL_MAX_TOKENS: "8000"
  GEMINI_RESPONSE_COMPREHENSIVE_MAX_TOKENS: "30000"
  
  # Azure Search (AzureCognitiveSearch)
  AZURE_SEARCH_SERVICE: "your-search-service"
  AZURE_SEARCH_INDEX: "your-search-index"
  AZURE_SEARCH_KEY: "YOUR_AZURE_SEARCH_KEY_HERE"
  AZURE_SEARCH_SEMANTIC_SEARCH_CONFIG: "your-semantic-config"
  AZURE_SEARCH_INDEX_IS_PRECHUNKED: "False"
  AZURE_SEARCH_TOP_K: "10"
  AZURE_SEARCH_ENABLE_IN_DOMAIN: "true"
  AZURE_SEARCH_CONTENT_COLUMNS: "chunk,fieldMetadata"
  AZURE_SEARCH_FILENAME_COLUMN: "metadata_storage_name"
  AZURE_SEARCH_TITLE_COLUMN: "titreDocument"
  AZURE_SEARCH_URL_COLUMN: "metadata_storage_path"
  AZURE_SEARCH_VECTOR_COLUMNS: "text_vector"
  AZURE_SEARCH_QUERY_TYPE: "vector_semantic_hybrid"
  AZURE_SEARCH_PERMITTED_GROUPS_COLUMN: ""
  AZURE_SEARCH_STRICTNESS: "4"
  AZURE_SEARCH_USE_SEMANTIC_SEARCH: "true"
  
  # Azure Speech Services
  AZURE_SPEECH_KEY: "YOUR_AZURE_SPEECH_KEY_HERE"
  AZURE_SPEECH_REGION: "your-region"
  AZURE_SPEECH_VOICE_FR: "fr-FR-HenriNeural"
  AZURE_SPEECH_VOICE_EN: "en-US-GuyNeural"
  
  # CosmosDB (for chat history)
  AZURE_COSMOSDB_ACCOUNT: "your-cosmosdb-account"
  AZURE_COSMOSDB_DATABASE: "your-database-name"
  AZURE_COSMOSDB_CONVERSATIONS_CONTAINER: "conversations"
  AZURE_COSMOSDB_ACCOUNT_KEY: "YOUR_COSMOSDB_KEY_HERE"
  AZURE_COSMOSDB_ENABLE_FEEDBACK: "True"
  
  # Custom Avanteam Configuration
  AVANTEAM_URL_BASE: "https://your-domain.com/QMDOC/"
  AVANTEAM_AUTH_TOKEN: "YOUR_AVANTEAM_TOKEN_HERE"
  AVANTEAM_LICENCEHUB_HANDLERURL: "https://your-license-hub.com/handler.ashx"
  AVANTEAM_LICENCEHUB_KEY: "YOUR_LICENSE_KEY_HERE"
  
  # MS Defender (disabled by default)
  MS_DEFENDER_ENABLED: "false"
  MS_DEFENDER_ENDPOINT: ""
  MS_DEFENDER_KEY: ""