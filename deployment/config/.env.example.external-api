# =====================================================
# EXTERNAL API CONFIGURATION EXAMPLE
# =====================================================
#
# This file shows how to configure the External API
# for document search integration with external clients
# like LightOn, Custom LLMs, etc.
#
# Copy relevant sections to your main .env file
# =====================================================

# Enable/Disable External API
EXTERNAL_API_ENABLED=true

# API Keys Configuration
# Format: "client_name:api_key:allowed_ip1,allowed_ip2|client2_name:api_key2:*"
# Use * for allowed IPs to allow any IP address
# Examples:
EXTERNAL_API_KEYS="lighton:sk-ext-lighton-12345:192.168.1.100,10.0.0.50|internal_tool:sk-ext-internal-67890:*"

# Swagger/OpenAPI Documentation
EXTERNAL_API_SWAGGER_ENABLED=true
EXTERNAL_API_TITLE="AskMe External API"
EXTERNAL_API_DESCRIPTION="REST API for external document search integration"
EXTERNAL_API_VERSION="1.0.0"

# Rate Limiting (per client)
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=60
EXTERNAL_API_RATE_LIMIT_PER_HOUR=1000

# Search Limits
EXTERNAL_API_MAX_RESULTS=50
EXTERNAL_API_REQUEST_TIMEOUT=30

# =====================================================
# SEARCH PROVIDER CONFIGURATION
# =====================================================
# The External API uses the same search provider as your main app
# Make sure these are configured correctly:

# Search Provider (new format, recommended)
SEARCH_PROVIDER=azure_search

# Legacy format (still supported for backward compatibility)
# DATASOURCE_TYPE=AzureCognitiveSearch

# Azure AI Search Configuration
AZURE_SEARCH_SERVICE=your-search-service-name
AZURE_SEARCH_INDEX=your-index-name
AZURE_SEARCH_KEY=your-search-admin-key

# Optional: Advanced search features
AZURE_SEARCH_USE_SEMANTIC_SEARCH=true
AZURE_SEARCH_SEMANTIC_SEARCH_CONFIG=default

# =====================================================
# EXAMPLE CLIENT CONFIGURATIONS
# =====================================================

# LightOn Integration Example
# EXTERNAL_API_KEYS="lighton:sk-ext-lighton-prod-xyz123:*"

# Multiple Clients Example
# EXTERNAL_API_KEYS="lighton:sk-ext-lighton-xyz123:195.154.1.100|partner_ai:sk-ext-partner-abc456:10.0.0.0/8|internal:sk-ext-internal-def789:*"

# High-Volume Client Example (higher limits)
# For custom per-client limits, modify backend/api/auth.py get_rate_limit_for_client()

# =====================================================
# SECURITY RECOMMENDATIONS
# =====================================================

# 1. Use strong, unique API keys (minimum 32 characters)
# 2. Restrict IP addresses when possible (avoid * in production)
# 3. Monitor API usage and set up alerts
# 4. Rotate API keys regularly (every 90 days recommended)
# 5. Use HTTPS in production (certificate required)

# =====================================================
# MONITORING & LOGGING
# =====================================================
# All API requests are automatically logged with:
# - Client identification
# - IP address
# - Request/response timing
# - Error details
# - Usage statistics
#
# Check application logs for:
# - "API auth success" - successful authentication
# - "API auth failed" - failed authentication attempts
# - "API request completed" - successful requests
# - "Rate limit exceeded" - rate limiting events

# =====================================================
# TESTING THE API
# =====================================================
# Once configured, test the API with:
#
# curl -X POST "http://localhost:50505/api/v1/search" \
#   -H "Authorization: Bearer sk-ext-lighton-xyz123" \
#   -H "Content-Type: application/json" \
#   -d '{
#     "query": "Comment configurer Azure AD?",
#     "max_results": 5,
#     "include_metadata": true
#   }'
#
# Health check (no auth required):
# curl http://localhost:50505/api/v1/health
#
# API capabilities:
# curl http://localhost:50505/api/v1/capabilities
#
# Swagger Documentation:
# http://localhost:50505/openapi.json
# =====================================================