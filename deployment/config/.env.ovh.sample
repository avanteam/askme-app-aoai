# =============================================================================
# CONFIGURATION ENVIRONNEMENT OVH AI ENDPOINTS POUR ASKME-APP-AOAI
# =============================================================================
# Ce fichier contient toutes les variables d'environnement nécessaires pour
# configurer le provider OVH AI Endpoints dans AskMe.
#
# Instructions:
# 1. Copiez ce fichier vers .env dans le répertoire racine
# 2. Remplacez les valeurs d'exemple par vos vraies configurations
# 3. Ajoutez OVH aux providers disponibles
# =============================================================================

# =============================================================================
# AUTHENTICATION OVH AI ENDPOINTS
# =============================================================================
# Token d'accès OVH AI Endpoints (OBLIGATOIRE)
# Obtenez-le depuis votre Control Panel OVH > Public Cloud > AI Endpoints
OVH_AI_ENDPOINTS_ACCESS_TOKEN=your_ovh_access_token_here

# =============================================================================
# CONFIGURATION MODELE PAR DEFAUT
# =============================================================================
# Modèle par défaut à utiliser (optionnel, défaut: llama-3.3-70b)
# Modèles disponibles:
# - Conversation: llama-3.3-70b, mixtral-8x7b, qwen-3-32b, llama-3.1-8b, mistral-nemo
# - Raisonnement: gpt-oss-20b, deepseek-r1-distill-llama-70b
# - Code: qwen-2.5-coder-32b, codestral-mamba
# - Vision: qwen-2.5-vl-72b
OVH_MODEL=llama-3.3-70b

# Sélection automatique de modèle selon le contexte (défaut: true)
# Si activé, le système choisit automatiquement le meilleur modèle selon la requête
OVH_AUTO_MODEL_SELECTION=true

# =============================================================================
# CONFIGURATION API
# =============================================================================
# URL de l'API OVH AI Endpoints (recommandé: endpoint unifié)
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1

# =============================================================================
# PARAMETRES DE GENERATION
# =============================================================================
# Créativité des réponses (0.0 = déterministe, 2.0 = très créatif)
OVH_TEMPERATURE=0.7

# Diversité des réponses via nucleus sampling (0.1 = focalisé, 1.0 = divers)
OVH_TOP_P=1.0

# =============================================================================
# LONGUEUR DES REPONSES
# =============================================================================
# Nombre maximum de tokens pour les réponses très courtes
OVH_RESPONSE_VERY_SHORT_MAX_TOKENS=150

# Nombre maximum de tokens pour les réponses normales
OVH_RESPONSE_NORMAL_MAX_TOKENS=1000

# Nombre maximum de tokens pour les réponses détaillées
OVH_RESPONSE_COMPREHENSIVE_MAX_TOKENS=2500

# =============================================================================
# MESSAGE SYSTEME
# =============================================================================
# Message système par défaut pour les conversations
OVH_SYSTEM_MESSAGE="Tu es un assistant IA serviable, précis et détaillé. Tu réponds en français sauf si on te demande explicitement une autre langue."

# =============================================================================
# CONFIGURATION MODELES DE RAISONNEMENT (GPT-OSS-20B, DEEPSEEK-R1)
# =============================================================================
# Intensité du raisonnement pour les modèles compatibles (low/medium/high)
# Plus l'intensité est élevée, plus le raisonnement sera détaillé
OVH_REASONING_EFFORT=medium

# Afficher le contenu de raisonnement dans l'interface utilisateur
OVH_SHOW_REASONING_IN_UI=true

# =============================================================================
# GESTION DES LIMITES DE DEBIT
# =============================================================================
# Nombre maximum de requêtes par minute (limite OVH: 400/min avec auth, 2/min anonyme)
OVH_MAX_REQUESTS_PER_MINUTE=380

# Réessayer automatiquement après les erreurs de limite de débit (429)
OVH_RETRY_AFTER_429=true

# =============================================================================
# CONFIGURATION AVANCEE DES MODELES
# =============================================================================
# Liste des modèles disponibles (détectés automatiquement si non spécifiés)
# Format: liste séparée par des virgules
# OVH_AVAILABLE_MODELS=llama-3.3-70b,mixtral-8x7b,qwen-3-32b,gpt-oss-20b,qwen-2.5-coder-32b,qwen-2.5-vl-72b

# Modèles optimisés pour la conversation générale
OVH_CONVERSATION_MODELS=llama-3.3-70b,mixtral-8x7b,qwen-3-32b,llama-3.1-8b,mistral-nemo

# Modèles avec capacités de raisonnement avancées
OVH_REASONING_MODELS=gpt-oss-20b,deepseek-r1-distill-llama-70b

# Modèles spécialisés pour la génération de code
OVH_CODING_MODELS=qwen-2.5-coder-32b,codestral-mamba

# Modèles avec capacités vision et multimodales
OVH_VISION_MODELS=qwen-2.5-vl-72b

# =============================================================================
# CONFIGURATION PROVIDERS DISPONIBLES
# =============================================================================
# Ajoutez OVH à la liste des providers disponibles
# Formats supportés: AZURE_OPENAI,CLAUDE,OPENAI_DIRECT,MISTRAL,GEMINI,OVH
AVAILABLE_LLM_PROVIDERS=OVH,CLAUDE,AZURE_OPENAI

# Provider par défaut (doit être dans AVAILABLE_LLM_PROVIDERS)
LLM_PROVIDER=OVH

# =============================================================================
# CONFIGURATION AZURE SEARCH (OPTIONNEL POUR RAG)
# =============================================================================
# Si vous voulez utiliser la recherche Azure avec OVH AI Endpoints,
# décommentez et configurez ces variables :

# DATASOURCE_TYPE=AzureCognitiveSearch
# AZURE_SEARCH_SERVICE=your-search-service
# AZURE_SEARCH_INDEX=your-search-index
# AZURE_SEARCH_KEY=your-search-key
# AZURE_SEARCH_QUERY_TYPE=semantic
# AZURE_SEARCH_SEMANTIC_SEARCH_CONFIG=your-semantic-config
# AZURE_SEARCH_CONTENT_COLUMNS=content
# AZURE_SEARCH_FILENAME_COLUMN=filename
# AZURE_SEARCH_TITLE_COLUMN=title
# AZURE_SEARCH_URL_COLUMN=url

# =============================================================================
# CONFIGURATION COMMANDES CHAT
# =============================================================================
# Activer/désactiver les commandes de chat en langage naturel
# WARNING: Actuellement désactivé par défaut en raison de bugs. Définir à true pour activer.
CHAT_COMMANDS_ENABLED=false

# =============================================================================
# EXEMPLES DE COMMANDES CHAT
# =============================================================================
# Une fois CHAT_COMMANDS_ENABLED=true, les utilisateurs peuvent changer de modèle via le chat:
#
# "Modifie la config pour utiliser Llama 70B"
# "Passe sur Qwen vision pour analyser des images"
# "Utilise le modèle de code Qwen pour cette tâche"
# "Switche sur GPT reasoning pour ce problème complexe"
# "Change pour DeepSeek avec des réponses détaillées"
#
# Modèles supportés en commandes naturelles:
# - llama, llama 70b, llama 3.3
# - qwen, qwen 32b, qwen 3
# - mixtral, mixtral 8x7b
# - gpt reasoning, gpt-oss, deepseek, deepseek r1
# - qwen coder, qwen code, codestral, codestral mamba
# - qwen vision, qwen vl, qwen multimodal
# =============================================================================